# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# C3 USB Serial/JTAG cannot survive light sleep. Keep flashing/monitoring usable
# with an enumerated USB host; battery-only operation still permits light sleep.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
# Vibe styles every object; avoid allocating the unused default theme.
CONFIG_LV_USE_THEME_DEFAULT=n
CONFIG_LV_USE_THEME_SIMPLE=n
# LVGL 内置 malloc 池大小(KB)。它是独立静态区、不与系统堆共享,配大了会白白占用 RAM。
# 本 demo UI 简单,24KB 足够;若自建复杂界面出现绘制卡死/看门狗,调大此值。
CONFIG_LV_MEM_SIZE_KILOBYTES=26
CONFIG_BSP_LVGL_DRAW_BUFFER_LINES=20

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000
# Periodic wakeups must leave more than the 8 ms automatic-sleep threshold.
# 20 ms polling keeps physical input responsive; debounce remains one sample.
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=8
CONFIG_BUTTON_PERIOD_TIME_MS=20
CONFIG_BUTTON_DEBOUNCE_TICKS=1

# --- Bluetooth LE / NimBLE ---
# ESP32-C3 BLE peripheral: owner + temporary takeover connection, no scanning.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# Do not emit one INFO log for every audio notification fragment.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# Vibe companion: modem sleep and automatic light sleep.
CONFIG_PM_ENABLE=y
CONFIG_PM_PROFILING=y
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
CONFIG_ESP_SLEEP_DEBUG=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
# Recover internal SRAM from optional speed optimizations. Keep ISR code and
# the sleep policy intact; voice/radio throughput must be checked on hardware.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# Radio HTTPS overlaps the decoder/FIFO. Keep TX dynamic and release handshake
# data. Radio requests reserve RX post-handshake before codec/FIFO allocations;
# short-lived weather HTTPS keeps the default dynamic RX strategy.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_LV_TXT_ENC_UTF8=y
CONFIG_LV_USE_FONT_PLACEHOLDER=y

CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_MONTSERRAT_36=y

# Computer-relayed radio and voice share the application IMA codec.
# No AAC/MP3 decoder or container parser is linked into the device.

# Two peripheral connections: owner plus a bounded takeover slot, and advertising.
CONFIG_BT_CTRL_BLE_MAX_ACT=3
CONFIG_BT_NIMBLE_MAX_BONDS=8
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_GATT_CLIENT=n
# IDF 5.5.3 runtime-block pools are unsafe with dynamic-context teardown.
# Allocate bounded pools at BLE startup and reclaim them at stack shutdown.
CONFIG_BT_NIMBLE_MEMPOOL_RUNTIME_ALLOC=n
CONFIG_BT_NIMBLE_STATIC_TO_DYNAMIC=y
CONFIG_BT_NIMBLE_MEMPOOL_BLOCK_REUSED=n
CONFIG_BT_NIMBLE_HS_FLOW_CTRL=n
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
CONFIG_ESP_PHY_MAC_BB_PD=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
# Low-rate audio/control does not need the default 24 ACL / 30 event buffers.
# One ATT write at a time; notifications are fragmented to the negotiated MTU.
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=3
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=2
CONFIG_BT_NIMBLE_LOW_SPEED_MODE=y
CONFIG_BT_CTRL_DTM_ENABLE=n
CONFIG_BT_CTRL_BLE_SCAN=n
# Recover controller IRAM rather than stealing the radio/voice safety reserve.
# Flash erases can delay BLE: configuration/bond persistence is tested on-device.
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
